pipeline {
    
    agent any
    
    stages {
        stage ('Get Code') {
            steps {
                git url:'https://github.com/daniel-unir/todo-list-aws', branch: 'develop'
                sh 'wget -O samconfig.toml https://raw.githubusercontent.com/daniel-unir/todo-list-aws-config/refs/heads/staging/samconfig.toml'
            }
        }
        stage ('Static Test') {
            steps {
                sh '''
                export PYTHONPATH=$WORKSPACE
                python -m flake8 --output-file flake8.out --format pylint --exit-zero src
                python -m bandit -r src -f xml -o bandit.xml
                '''
                recordIssues tools: [pyLint(name: 'Bandit', pattern: 'bandit.xml')]
                recordIssues tools: [flake8(name: 'Flake8', pattern: 'flake8.out')]
            }
        }
        stage ('Deploy'){
            steps {
                sh '''
                sam build
                sam deploy --stack-name todo-list-aws-staging --resolve-s3 --region us-east-1
                '''
            }
        }
        stage('Rest Test'){
            steps{
                script {
                    def BASE_URL = sh( script: "aws cloudformation describe-stacks --stack-name todo-list-aws-staging --query 'Stacks[0].Outputs[?OutputKey==`BaseUrlApi`].OutputValue' --region us-east-1 --output text",
                        returnStdout: true).trim()
                    env.BASE_URL = BASE_URL
                    sh 'python -m pytest --junitxml=result-rest.xml test/integration/todoApiTest.py'
                    junit 'result-rest.xml'
                }
            }
        }
            stage ('Get Code Prod') {
            steps {
                git url:'https://github.com/daniel-unir/todo-list-aws', branch: 'master'
                sh 'wget -O samconfig.toml https://raw.githubusercontent.com/daniel-unir/todo-list-aws-config/refs/heads/production/samconfig.toml'
            }
        }
        stage ('Deploy Prod'){
            steps {
                sh '''
                sam build
                sam deploy --stack-name todo-list-aws-production --resolve-s3 --region us-east-1
                '''
            }
        }
        stage('Rest Test Prod'){
            steps{
                script {
                    def BASE_URL = sh( script: "aws cloudformation describe-stacks --stack-name todo-list-aws-production --query 'Stacks[0].Outputs[?OutputKey==`BaseUrlApi`].OutputValue' --region us-east-1 --output text",
                        returnStdout: true).trim()
                    env.BASE_URL = BASE_URL
                    sh 'python -m pytest --junitxml=result-rest.xml test/integration/todoApiTest.py -k "test_api_listtodos or test_api_gettodo"'
                    junit 'result-rest.xml'
                }
            }
        }
    }
    post {
        always {
            deleteDir()
            cleanWs()
            sh 'sam delete --stack-name todo-list-aws-staging --no-prompts --region us-east-1'
            sh 'sam delete --stack-name todo-list-aws-production --no-prompts --region us-east-1'
        }
    }
}
